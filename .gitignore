# Local datasets and generated data
data/

# Keep reproducible binary data and delivery/log archives out of source review.
*.parquet
*.zip
*.tar.gz
*.tgz

# Historical binaries and deliveries are transferred separately from Git.
/archive/models/
/archive/deliveries/
/archive/failed-publication/

# Reproducible Spark ML outputs
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/metrics/*
!artifacts/metrics/.gitkeep
artifacts/predictions/*
!artifacts/predictions/.gitkeep
artifacts/experiments/
artifacts/flighttime-v3/
artifacts/failed-publication/

# Python runtime caches
__pycache__/
*.py[cod]

# Temporarily excluded project scripts
scripts/
!scripts/
scripts/*
!scripts/run_pipeline.sh
!scripts/run_tests.sh
!scripts/scripts_download_bts.sh
!scripts/start_cluster.sh
!scripts/stop_cluster.sh

# macOS metadata
.DS_Store

# IntelliJ IDEA local workspace state
.idea/workspace.xml
.idea/**/workspace.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
!scripts/verify_dependencies.py
!scripts/package_evidence.py
!scripts/validate_csv.py
.pytest_cache/
notebooks/.ipynb_checkpoints/

# Host-specific mounts; a clean clone uses docker-compose.yml.
docker-compose.override.yml
